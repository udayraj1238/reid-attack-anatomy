# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure code, data, and docs use LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.pth binary
*.pptx binary
*.zip binary
